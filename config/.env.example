# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
BQ_DATASET=fakenews_ml
BQ_RAW_TABLE=raw_tweets
BQ_FEATURES_TABLE=features
GCS_BUCKET=your-ml-bucket

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fakenews-detection

# Model Serving
MODEL_NAME=fakenews_classifier
MODEL_VERSION=latest
API_PORT=8080

# Monitoring
DRIFT_THRESHOLD_PSI=0.2
DRIFT_CHECK_INTERVAL_HOURS=6
REFERENCE_DATA_PATH=gs://your-ml-bucket/reference/baseline.parquet
